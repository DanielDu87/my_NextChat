# =============================================================================
# Code Interpreter API - 独立部署环境变量
# =============================================================================
# 仅本机读；.gitignore 已忽略。token 不进仓库。
# =============================================================================

# 必填：生成独立的随机 Bearer Token；NextChat 插件页 authToken 粘贴同一值
AUTH_TOKEN=replace-with-a-random-secret

# 监听端口（容器内 5000；compose 映射到 127.0.0.1:5000）
PORT=5000
HOST=0.0.0.0

# 代码执行超时（秒）
TIMEOUT=60

# 输出图片以 base64 形式放在 JSON.images，NextChat /runcode 协议兼容
OUTPUT_BASE64=true

# 自动剥掉 ```python ... ``` 围栏，避免模型把 markdown 一起送进来
REMOVE_PYTHON_CODE_BLOCK=true
