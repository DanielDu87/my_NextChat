# NextChat 生产环境配置（远程服务器部署）
# 用于在 42.193.15.117 服务器上部署
# 此配置直接连接本地数据库，不使用 SSH 隧道

OPENAI_API_KEY=
CODE=nextchat@local123
BASE_URL=
OPENAI_ORG_ID=
GOOGLE_API_KEY=
HIDE_USER_API_KEY=
DISABLE_GPT4=
ENABLE_BALANCE_QUERY=
DISABLE_FAST_LINK=
OPENAI_SB=

# WebDAV 同步配置
WHITE_WEBDAV_ENDPOINTS=https://webdav.dyxcloud.com/
WEBDAV_USERNAME=dyx
WEBDAV_PASSWORD=dyx123

# 生产环境数据库配置（直接连接本地数据库）
PGHOST=localhost
PGPORT=5432
PGDATABASE=nextchat
PGUSER=dyx
PGPASSWORD=NrCCTyikNREXjiZ6
PGSSL=false
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# PostgreSQL 完整连接字符串
DATABASE_URL=postgresql://dyx:NrCCTyikNREXjiZ6@localhost:5432/nextchat

# PostgreSQL SSL 模式
PGSSLMODE=disable

# 同步数据归属 ID（不是登录用户名）
NEXTCHAT_DEFAULT_USER_ID=user:admin
DEFAULT_SYNC_USER_ID=user:admin

# 重要：永远不使用代理
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
