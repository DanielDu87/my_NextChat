# =============================================================================
# NextChat 宝塔面板环境变量配置
# =============================================================================
# 项目说明：
# 本项目使用自定义构建的 NextChat Docker 镜像，而非官方预构建镜像。
# 自定义镜像可能包含以下修改：
# - 自定义 AI 提供商集成
# - 服务器端 API Key 配置
# - 其他定制功能
#
# 使用说明：
# 1. 复制此文件为 .env.baota.local
# 2. 修改 [必填] 标记的配置项
# 3. 在宝塔 Docker 管理器中使用此配置
# =============================================================================

# ---------------------------------------------------------------------------
# [必填] 基础访问配置
# ---------------------------------------------------------------------------

# 服务端口（容器内部端口，通过 Nginx 反向代理访问）
PORT=3000

# 访问密码（必填）- 设置后用户需要输入密码才能访问
CODE=your-access-password-here

# ---------------------------------------------------------------------------
# AI 服务商配置（可选）
# ---------------------------------------------------------------------------
# 说明：
# 1. 如果服务器已配置自定义 AI 提供商，此项留空即可
# 2. 用户可以在界面中自行配置 API Key 和 Base URL
# 3. 如果要设置默认 API Key，可以填写（非必需）
# ---------------------------------------------------------------------------

# OpenAI API 配置（可选 - 服务器已配置自定义提供商时留空）
OPENAI_API_KEY=

# Google API 配置（可选）
GOOGLE_API_KEY=

# 自定义 API 地址（可选 - 服务器已配置时留空）
BASE_URL=

# 其他 AI 提供商配置（可选）
ANTHROPIC_API_KEY=
AZURE_URL=
AZURE_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BYTEDANCE_API_KEY=
ALIBABA_API_KEY=
TENCENT_SECRET_KEY=
TENCENT_SECRET_ID=
MOONSHOT_API_KEY=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CHATGLM_API_KEY=
SILICONFLOW_API_KEY=
AI302_API_KEY=

# ---------------------------------------------------------------------------
# [必填] 用户标识配置 - 影响数据存储
# ---------------------------------------------------------------------------
# 注意：三个变量必须保持一致，否则会导致数据无法加载
NEXTCHAT_DEFAULT_USER_ID=single-user
DEFAULT_SYNC_USER_ID=single-user
NEXT_PUBLIC_DEFAULT_SYNC_USER_ID=single-user

# ---------------------------------------------------------------------------
# [必填] 数据库配置 - 使用宝塔 PostgreSQL
# ---------------------------------------------------------------------------

# 数据库连接信息
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nextchat
PGUSER=nextchat_user
PGPASSWORD=your-db-password-here

# SSL 配置（宝塔本地数据库设为 false）
PGSSL=false
PGSSLMODE=disable

# 连接池配置（可选，使用默认值即可）
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# 国内加速配置（建议保留）
# ---------------------------------------------------------------------------

# Alpine 镜像源
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

# NPM 镜像源
NPM_REGISTRY=https://registry.npmmirror.com/

# YARN 网络超时
YARN_NETWORK_TIMEOUT=600000

# ---------------------------------------------------------------------------
# 功能配置（按需修改）
# ---------------------------------------------------------------------------

# 隐藏用户 API Key 输入框
# 设为 true 时，用户无法在界面中配置自己的 API Key
# 如果服务器已配置自定义提供商，建议设为 true
HIDE_USER_API_KEY=false

# 禁用 GPT-4 模型
DISABLE_GPT4=false

# 启用余额查询
ENABLE_BALANCE_QUERY=false

# 禁用快速链接（从 URL 解析设置）
DISABLE_FAST_LINK=false

# 启用 MCP 功能
ENABLE_MCP=false

# 启用 Google 字体（国内建议关闭）
ENABLE_GOOGLE_FONTS=false

# 默认模型（可选）
# DEFAULT_MODEL=gpt-3.5-turbo

# ---------------------------------------------------------------------------
# GitHub 配置（如访问 GitHub 有问题可使用镜像）
# ---------------------------------------------------------------------------

GITHUB_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# ---------------------------------------------------------------------------
# WebDAV 同步配置（可选）
# ---------------------------------------------------------------------------

WHITE_WEBDAV_ENDPOINTS=
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
