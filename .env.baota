# =============================================================================
# NextChat 宝塔面板部署配置
# =============================================================================
# 使用方式：
# 1. 将此文件上传到服务器 /www/wwwroot/nextchat/.env.baota
# 2. 修改以下配置项（带 [必填] 标记的必须修改）
# 3. 在宝塔 Docker 管理器中使用此配置文件部署
# =============================================================================

# ---------------------------------------------------------------------------
# 基础配置
# ---------------------------------------------------------------------------

# 服务端口（默认 3000，通过 Nginx 反向代理访问）
PORT=3000

# 访问密码（必填）- 多个密码用逗号分隔
CODE=your-password-here

# OpenAI API 配置（必填 - 至少填一个）
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 自定义 API 地址（可选 - 如果使用代理）
BASE_URL=

# ---------------------------------------------------------------------------
# 用户标识配置（重要！影响数据存储）
# ---------------------------------------------------------------------------
# 所有用户共享同一个 ID，数据会存储在一起
NEXTCHAT_DEFAULT_USER_ID=single-user
DEFAULT_SYNC_USER_ID=single-user
NEXT_PUBLIC_DEFAULT_SYNC_USER_ID=single-user

# ---------------------------------------------------------------------------
# 数据库配置（推荐使用宝塔 PostgreSQL）
# ---------------------------------------------------------------------------
# 方案 1: 使用宝塔 PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nextchat
PGUSER=nextchat_user
PGPASSWORD=your-db-password-here
PGSSL=false
PGSSLMODE=disable

# 方案 2: 使用远程 PostgreSQL
# PGHOST=your-remote-db-ip
# PGPORT=5432
# PGDATABASE=nextchat
# PGUSER=your-db-user
# PGPASSWORD=your-db-password
# PGSSL=false

# ---------------------------------------------------------------------------
# 国内加速配置（建议保留）
# ---------------------------------------------------------------------------
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com/

# ---------------------------------------------------------------------------
# 其他配置（按需修改）
# ---------------------------------------------------------------------------
HIDE_USER_API_KEY=true
DISABLE_GPT4=false
ENABLE_BALANCE_QUERY=false
DISABLE_FAST_LINK=false
ENABLE_MCP=false
ENABLE_GOOGLE_FONTS=false

# GITHUB 配置（如果访问 GitHub 有问题，使用镜像）
GITHUB_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# ---------------------------------------------------------------------------
# WebDAV 同步配置（可选）
# ---------------------------------------------------------------------------
WHITE_WEBDAV_ENDPOINTS=
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
