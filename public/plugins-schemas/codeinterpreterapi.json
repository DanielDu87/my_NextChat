{
  "openapi": "3.1.0",
  "info": {
    "title": "CodeInterpreter",
    "description": "Run Python code through Code Interpreter API. The NextChat self-hosted endpoint is reverse-proxied behind chat.dyxcloud.com and requires Bearer Token authentication.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://chat.dyxcloud.com/codeinterpreter"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token shared between NextChat and the self-hosted Code Interpreter API."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/runcode": {
      "post": {
        "operationId": "CodeInterpreter",
        "x-openai-isConsequential": false,
        "summary": "Run a given Python program and return the output.",
        "description": "Execute Python code in the remote Code Interpreter API sandbox and return stdout plus generated image URLs when present.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "languageType"],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "The Python code to execute"
                  },
                  "languageType": {
                    "type": "string",
                    "description": "value is `python`"
                  },
                  "variables": {
                    "type": "object",
                    "description": "Optional variables passed to the code. Use an empty object when not needed.",
                    "default": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Code execution result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "output": {
                      "type": "string",
                      "description": "Standard output from the executed code."
                    },
                    "images": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Generated image filenames mapped to accessible image URLs."
                    },
                    "files": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "base64": {
                            "type": "string",
                            "description": "Base64-encoded file content. Present when the file is newly generated during code execution."
                          },
                          "url": {
                            "type": "string",
                            "description": "Accessible download URL after NextChat uploads the file to cache."
                          },
                          "contentType": {
                            "type": "string"
                          },
                          "size": {
                            "type": "number"
                          }
                        }
                      },
                      "description": "Generated files mapped to downloadable NextChat cache URLs. Use these URLs instead of sandbox:/mnt/data links."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Invalid JSON or parameters."
          },
          "401": {
            "description": "Unauthorized. Missing or invalid token when authentication is enabled by the API server."
          },
          "405": {
            "description": "Method not allowed."
          },
          "504": {
            "description": "Code execution timed out."
          }
        }
      }
    }
  }
}
