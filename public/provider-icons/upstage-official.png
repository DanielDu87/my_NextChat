<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 모든 target="_blank" 링크 찾기
    const externalLinks = document.querySelectorAll('a[target="_blank"]');
    
    externalLinks.forEach(link => {
      // 현재 rel 값 가져오기
      const currentRel = link.getAttribute('rel') || '';
      
      // noopener noreferrer 추가 (중복 방지)
      const relValues = new Set(currentRel.split(' ').filter(Boolean));
      relValues.add('noopener');
      relValues.add('noreferrer');
      
      link.setAttribute('rel', Array.from(relValues).join(' '));
    });
  });
</script>

<!-- ✅ Clean URL Script (for Webflow + Google Analytics) -->
<script>
  (function() {
    try {
      const url = new URL(window.location.href);

      // 제거할 Google 관련 파라미터 목록
      const googleParams = ['_gl', '_ga', '_ga_XHVZT7B35B', '_gcl_au'];

      let changed = false;
      googleParams.forEach(param => {
        if (url.searchParams.has(param)) {
          url.searchParams.delete(param);
          changed = true;
        }
      });

      // 파라미터가 제거된 경우만 URL을 업데이트
      if (changed) {
        const cleanUrl =
          url.pathname + (url.searchParams.toString() ? '?' + url.searchParams.toString() : '');
        window.history.replaceState({}, '', cleanUrl);
      }
    } catch (e) {
      console.warn('Clean URL script error:', e);
    }
  })();
</script>


<script>
(function() {
  // 만약 location.pathname === '/jp' 이고, 이전 페이지가 /careertalk-sep25 라면 → 되돌리기
  if (window.location.pathname === "/jp" && document.referrer.includes("/careers/careertalk-sep25")) {
    window.location.href = "/careers/careertalk-sep25"; // 원래 위치로 되돌리기
  }
})();
</script>


<script>
(function() {
  // 경로가 해당 리디렉트 페이지인 경우만 적용
  if (window.location.pathname.includes("/careers/careertalk-sep25")) {

    // 1. 불필요한 쿼리 스트링 제거
    if (window.location.search) {
      const cleanUrl = window.location.origin + window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    }

    // 2. 기존 브라우저 쿠키 삭제
    document.cookie.split(";").forEach(function(cookie) {
      document.cookie = cookie
        .replace(/^ +/, "")
        .replace(/=.*/, "=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/");
    });

    // 3. HSTS preload 강제 무력화 (개발자 설정 시)
    console.log("리다이렉트 캐시 초기화 로직 실행됨");
  }
})();
</script>


<script>
(function() {
  // 방문자의 잘못된 리다이렉트 캐시 제거용: 쿼리 스트링/쿠키 제거
  if (window.location.pathname.includes("/careers/careertalk-sep25")) {
    // 브라우저 히스토리에서 쿼리 제거
    if (window.location.search) {
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    // 브라우저에 저장된 관련 쿠키 제거
    document.cookie.split(";").forEach(function(cookie) {
      document.cookie = cookie
        .replace(/^ +/, "")
        .replace(/=.*/, "=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/");
    });
  }
})();
</script>

<!-- A/B Test tracking via GTM dataLayer -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const abTests = [
      { selector: ".ab-test-topbar-set", key: "topbar", display: "block" },
      { selector: ".ab-test-hero-set", key: "hero", display: "inline-flex" },
      { selector: ".ab-test-feature-set", key: "feature", display: "inline-flex" },
      { selector: ".ab-test-footer-set", key: "footer", display: "inline-flex" }
    ];

    const today = new Date().toISOString().split("T")[0];
    const pagePath = window.location.pathname;

    abTests.forEach(test => {
      const sets = document.querySelectorAll(test.selector);
      if (sets.length === 0) return;

      const storageKey = `ab_test_${test.key}`;
      let storedData = localStorage.getItem(storageKey);
      let selectedIndex;

      if (storedData) {
        try {
          const parsed = JSON.parse(storedData);
          if (parsed.date === today && parsed.index < sets.length) {
            selectedIndex = parsed.index;
          }
        } catch (e) {}
      }

      if (selectedIndex === undefined) {
        selectedIndex = Math.floor(Math.random() * sets.length);
        localStorage.setItem(storageKey, JSON.stringify({ date: today, index: selectedIndex }));
      }

      sets.forEach((set, idx) => {
        if (idx === selectedIndex) {
          const isMobile = window.innerWidth < 768;
          let displayStyle = test.display;
          if (test.key === "hero" && isMobile) {
            displayStyle = "flex";
          }
          set.style.display = displayStyle;

          // Variant 값 추출
          const variant = set.querySelector("[data-variant]")?.getAttribute("data-variant") || `Variant ${selectedIndex + 1}`;

          // ✅ 개선 1: 노출(View) 데이터 GTM으로 전달 (Clarity 하드코딩 대체)
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            'event': 'ab_test_view',
            'ab_test_key': test.key,           // 예: 'topbar'
            'ab_test_variant': variant,        // 예: 'Variant 1'
            'page_path': pagePath
          });

          // ✅ 개선 2: 클릭(Click) 데이터 GTM으로 전달 (GA4, Clarity 하드코딩 대체)
          const buttons = set.querySelectorAll("a, button");
          buttons.forEach((btn) => {
            btn.addEventListener("click", function () {
              window.dataLayer.push({
                'event': 'ab_test_click',
                'ab_test_key': test.key,
                'ab_test_variant': variant,
                'ab_test_category': `${test.key.toUpperCase()} AB Test`,
                'page_path': pagePath
              });
            });
          });
        } else {
          set.style.display = "none";
        }
      });
    });
  });
</script>

<!--script>
  document.addEventListener("DOMContentLoaded", function () {
    const sets = document.querySelectorAll(".ab-test-topbar-set");

    if (sets.length === 0) return;

    const randomIndex = Math.floor(Math.random() * sets.length);

    sets.forEach((set, idx) => {
      set.style.display = idx === randomIndex ? "block" : "none"; // 또는 "inline-flex", 레이아웃에 따라 조정
    });
  });
</script-->

<!-- rich text h2+h3 margin-top -->
<style>
    [data-custom="rich-text"] h2 + h3 {
        margin-top: 2rem;
    }
</style>

<!--Start medium-zoom.js -->
<script src="https://cdn.jsdelivr.net/npm/medium-zoom@1.0.3/dist/medium-zoom.min.js"></script>
<script>
const images = Array.from(document.querySelectorAll(".post-wrapper img:not(.background-video img)"));
if ($(window).width() >= 991) {
  images.forEach(img => {
    mediumZoom(img, {
      margin: 0, /* The space outside the zoomed image */
      background: "#fff", /* The background of the overlay */
      scrollOffset: 40, /* The number of pixels to scroll to close the zoom */
      container: null, /* The viewport to render the zoom in */
      template: null /* The template element to display on zoom */
    });
  });
}
</script>
<!--End medium-zoom.js -->

<!-- Start UTM 동적 리다이렉트 (v=1 제외 버전) -->
<script>
  const currentUrlParams = new URLSearchParams(window.location.search);

  document.querySelectorAll('a').forEach(link => {
    try {
      const linkUrl = new URL(link.href, window.location.origin);

      // UTM 파라미터만 복사
      currentUrlParams.forEach((value, key) => {
        if (key.startsWith('utm_')) {
          linkUrl.searchParams.set(key, value);
        }
      });

      link.href = linkUrl.toString();
    } catch (e) {
      // 상대경로 등 파싱 불가능한 경우 무시
    }
  });
</script>
<!-- End UTM 동적 리다이렉트 -->

<!-- Finsweet ↔ Google Consent Mode 연동 브릿지 -->
<script>
function syncConsentToGoogle(settings) {
  // 1. 구글 동의 모드 업데이트 (GTM에 신호 전달)
  // if (typeof gtag === 'function') {
    gtag('consent', 'update', settings);
  // }
  
  // 2. 로컬스토리지에 저장 (다음 페이지 접속 시 Head에서 읽을 수 있도록)
  localStorage.setItem('consentMode', JSON.stringify(settings));
  
  // 🚨 UI 숨김(display: none) 로직은 Finsweet이 스스로 처리
}

// [모두 수락] 버튼 클릭 시
document.querySelector('[fs-cc="allow"]')?.addEventListener('click', function() {
  syncConsentToGoogle({
    'ad_storage': 'granted', 'ad_user_data': 'granted',
    'ad_personalization': 'granted', 'analytics_storage': 'granted',
    'functionality_storage': 'granted', 'security_storage': 'granted'
  });
});

// [모두 거부] 버튼 클릭 시
document.querySelector('[fs-cc="deny"]')?.addEventListener('click', function() {
  syncConsentToGoogle({
    'ad_storage': 'denied', 'ad_user_data': 'denied',
    'ad_personalization': 'denied', 'analytics_storage': 'denied',
    'functionality_storage': 'denied', 'security_storage': 'granted'
  });
});

// [설정 저장] 버튼 클릭 시 (맞춤 설정)
document.querySelector('[fs-cc="submit"]')?.addEventListener('click', function() {
  const analytics = document.getElementById('analytics')?.checked;
  const marketing = document.getElementById('marketing')?.checked;
  const functional = document.getElementById('functional')?.checked;

  syncConsentToGoogle({
    'ad_storage': marketing ? 'granted' : 'denied',
    'ad_user_data': marketing ? 'granted' : 'denied',
    'ad_personalization': marketing ? 'granted' : 'denied',
    'analytics_storage': analytics ? 'granted' : 'denied',
    'functionality_storage': functional ? 'granted' : 'denied',
    'security_storage': 'granted'
  });
});
</script>
</body></html>