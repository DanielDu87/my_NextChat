# =============================================================================
# NextChat 环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# =============================================================================

# ==================== 必填项 ====================

# OpenAI API 密钥
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# 访问密码（留空则无需密码）
CODE=your-password

# ==================== 可选项 ====================

# Google API 密钥
GOOGLE_API_KEY=

# 自定义 API 地址
BASE_URL=

# 隐藏用户 API 密钥输入框
HIDE_USER_API_KEY=true

# 禁用 GPT-4
DISABLE_GPT4=false

# 启用余额查询
ENABLE_BALANCE_QUERY=false

# 服务端口（默认 3000）
PORT=3000

# ==================== 仅服务器部署 ====================

# 代理 URL（用于访问 API）
PROXY_URL=

# Docker 镜像标签
IMAGE_TAG=latest
