{
  "name": "nextchat",
  "version": "2.16.1",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "./node_modules/.bin/next dev",
    "build": "cross-env BUILD_MODE=standalone next build",
    "start": "next start",
    "lint": "next lint",
    "export": "cross-env BUILD_MODE=export BUILD_APP=1 next build",
    "export:dev": "cross-env BUILD_MODE=export BUILD_APP=1 ./node_modules/.bin/next dev",
    "app:dev": "npx tauri dev",
    "app:build": "npx tauri build",
    "app:clear": "npx tauri dev",
    "models:published-at": "npx tsx ./scripts/maintain-models-published-at.ts",
    "db:health": "npx tsx ./scripts/check-postgres-health.ts",
    "db:sync-models": "npx tsx ./scripts/sync-models-to-postgres.ts",
    "db:refresh-provider-models": "npx tsx ./scripts/refresh-provider-models.ts",
    "db:seed-chat-performance": "npx tsx ./scripts/seed-chat-performance.ts",
    "db:migrate-chat-store": "npx tsx ./scripts/migrate-chat-store-to-conversations.ts",
    "db:migrate-draw-store": "npx tsx ./scripts/migrate-draw-store.ts",
    "db:cleanup-legacy-chat-store": "npx tsx ./scripts/cleanup-legacy-chat-state-sessions.ts",
    "db:cleanup-legacy-sync-storage": "npx tsx ./scripts/cleanup-legacy-sync-storage.ts",
    "db:drop-unused-tables": "npx tsx ./scripts/drop-unused-db-tables.ts",
    "db:purge-keep-provider-configs": "npx tsx ./scripts/purge-db-keep-provider-configs.ts",
    "db:unify-user-id": "npx tsx ./scripts/unify-user-id.ts",
    "db:migrate-sync-artifacts": "npx tsx ./scripts/migrate-sync-artifacts-to-dedicated-tables.ts",
    "db:record-deployment-version": "node ./scripts/record-deployment-version.mjs",
    "prepare": "sh -c 'if [ -d .git ] && [ -w .git ] && [ -w .git/config ]; then husky install; else echo \"husky skipped\"; fi'",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf npm run dev"
  },
