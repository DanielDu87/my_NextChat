# Docker / 国内服务器部署示例
# 使用方式：
# 1. 复制为 .env.docker 或直接写入你的部署环境变量
# 2. 执行：
#    docker compose --env-file .env.docker --profile no-proxy build
#    docker compose --env-file .env.docker --profile no-proxy up -d

# Alpine apk 国内镜像
# 示例：
# ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

# Docker 基础镜像国内镜像
# 如果你的 Docker Hub 很慢，可以改为国内镜像仓库地址
# 示例：
# NODE_IMAGE=docker.m.daocloud.io/library/node:18-alpine
NODE_IMAGE=docker.m.daocloud.io/library/node:18-alpine

# npm / yarn registry 国内镜像
NPM_REGISTRY=https://registry.npmmirror.com/
YARN_NETWORK_TIMEOUT=600000

# rt-client 的国内可访问 tgz 地址
# 如果不填，默认仍然走 GitHub release 直链
# 建议把该文件上传到你自己的 OSS / COS / CDN / 制品库
RT_CLIENT_TGZ_URL=

# 常见二进制下载镜像，可按依赖情况启用
SASS_BINARY_SITE=https://npmmirror.com/mirrors/node-sass/
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
PUPPETEER_DOWNLOAD_HOST=https://npmmirror.com/mirrors
CYPRESS_DOWNLOAD_MIRROR=https://npmmirror.com/mirrors/cypress
NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node

# 本地 Docker 开发热加载配置
# 大多数 Linux 服务器 / 本地开发环境建议保持 false，使用原生文件事件，热更新更快
# 如果你使用 Docker Desktop 且发现改文件后不能及时热更新，再改为 true
WATCHPACK_POLLING=false
WATCHPACK_POLLING_INTERVAL=1000
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=1000

# 下面这些是 compose 运行时常见变量，可按需填写
# 当前部署约定为全程不使用代理，因此这里不提供 PROXY_URL
OPENAI_API_KEY=
GOOGLE_API_KEY=
CODE=
BASE_URL=
OPENAI_ORG_ID=
HIDE_USER_API_KEY=
DISABLE_GPT4=
ENABLE_BALANCE_QUERY=
DISABLE_FAST_LINK=
ENABLE_MCP=
OPENAI_SB=
WHITE_WEBDAV_ENDPOINTS=
NEXTCHAT_DEFAULT_USER_ID=single-user
DEFAULT_SYNC_USER_ID=single-user

# 数据库 / WebDAV
# 服务器部署建议直接填写固定数据库地址，不依赖 SSH 隧道
# 示例：
# PGHOST=10.0.0.12
# PGPORT=5432
# PGDATABASE=nextchat
# PGUSER=nextchat_user
# PGPASSWORD=your-password
# 或者直接填写 DATABASE_URL
DATABASE_URL=
PGHOST=42.193.15.117
PGPORT=5432
PGDATABASE=nextchat
PGUSER=dyx
PGPASSWORD=NrCCTyikNREXjiZ6
PGSSL=
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# SSH 隧道仅在需要通过跳板机访问数据库时才启用
# 启用方式：
# docker compose --env-file .env.docker --profile no-proxy --profile ssh-tunnel up -d
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=222
SSH_TUNNEL_USER=
SSH_TUNNEL_PASSWORD=
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_LOCAL_PORT=5432
