# =============================================================================
# NextChat 本地开发环境变量模板
# =============================================================================
# 使用方法：
# 1. 复制此文件为 .env.local
# 2. 根据需要修改配置
# 3. 运行: docker-compose --profile local-db --profile dev up -d
# =============================================================================

# ---------------------------------------------------------------------------
# [必填] 基础访问配置
# ---------------------------------------------------------------------------
PORT=3000
CODE=your-access-password-here

# ---------------------------------------------------------------------------
# AI 服务商配置（可选 - 用户可在界面自行配置）
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
AZURE_URL=
AZURE_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BYTEDANCE_API_KEY=
ALIBABA_API_KEY=
TENCENT_SECRET_KEY=
TENCENT_SECRET_ID=
MOONSHOT_API_KEY=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CHATGLM_API_KEY=
SILICONFLOW_API_KEY=

# 自定义 API 地址（可选）
BASE_URL=

# ---------------------------------------------------------------------------
# [必填] 同步数据归属 ID - 不是登录用户名，三个变量必须保持一致
# ---------------------------------------------------------------------------
NEXTCHAT_DEFAULT_USER_ID=user:admin
DEFAULT_SYNC_USER_ID=user:admin
NEXT_PUBLIC_DEFAULT_SYNC_USER_ID=user:admin

# ---------------------------------------------------------------------------
# [必填] 数据库配置 - 使用 Docker 内置 PostgreSQL
# ---------------------------------------------------------------------------
# 本地开发使用 Docker 内置数据库，PGHOST 填容器名
PGHOST=postgres
PGPORT=5432
PGDATABASE=nextchat
PGUSER=postgres
PGPASSWORD=postgres

# SSL 配置（本地开发不使用 SSL）
PGSSL=false
PGSSLMODE=disable

# 连接池配置
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# 备份数据库（对话备份 / API 配置备份）
# 本地如需测试备份功能，可创建 nextchat_backup 或填 BACKUP_DATABASE_URL。
BACKUP_PGHOST=postgres
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=nextchat_backup
BACKUP_PGUSER=postgres
BACKUP_PGPASSWORD=postgres
BACKUP_PGSSL=false
BACKUP_PGSSLMODE=disable
BACKUP_PGPOOL_MAX=5
BACKUP_PG_CONNECT_TIMEOUT_MS=10000
BACKUP_PG_IDLE_TIMEOUT_MS=30000
BACKUP_PG_RETRY_COUNT=3

# ---------------------------------------------------------------------------
# [必填] 应用密钥 - 请修改为随机字符串
# ---------------------------------------------------------------------------
# ⚠️ 警告：修改此值会导致已加密的 API Key 无法解密！
# 本地开发可以使用固定值，但生产环境必须使用随机字符串
APP_SECRET=dev-secret-key-change-in-production

# ---------------------------------------------------------------------------
# 国内加速配置（建议保留）
# ---------------------------------------------------------------------------
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com/

# ---------------------------------------------------------------------------
# 功能配置
# ---------------------------------------------------------------------------
HIDE_USER_API_KEY=false
DISABLE_GPT4=false
ENABLE_BALANCE_QUERY=false
DISABLE_FAST_LINK=false
ENABLE_MCP=false
ENABLE_GOOGLE_FONTS=false

# ---------------------------------------------------------------------------
# 热加载配置（仅本地开发有效）
# ---------------------------------------------------------------------------
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=1000
WATCHPACK_POLLING=false

# ---------------------------------------------------------------------------
# GitHub 配置
# ---------------------------------------------------------------------------
GITHUB_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# ---------------------------------------------------------------------------
# 其他配置
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
