# =============================================================================
# NextChat 宝塔面板环境变量配置
# =============================================================================
# 数据库使用宿主机 Docker 网桥 PostgreSQL（当前 PGHOST=172.20.0.1）
# 网站通过 chat.dyxcloud.com 域名 + Nginx 反代（端口 3000）访问
# =============================================================================

# ---------------------------------------------------------------------------
# [必填] 基础访问配置
# ---------------------------------------------------------------------------
PORT=3000
CODE=your-access-password-here

# ---------------------------------------------------------------------------
# AI 服务商配置（可选 - 用户可在界面自行配置）
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
AZURE_URL=
AZURE_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BYTEDANCE_API_KEY=
ALIBABA_API_KEY=
TENCENT_SECRET_KEY=
TENCENT_SECRET_ID=
MOONSHOT_API_KEY=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CHATGLM_API_KEY=
SILICONFLOW_API_KEY=
AI302_API_KEY=

# 自定义 API 地址（可选）
BASE_URL=

# ---------------------------------------------------------------------------
# [必填] 同步数据归属 ID - 不是登录用户名，三个变量必须保持一致
# ---------------------------------------------------------------------------
NEXTCHAT_DEFAULT_USER_ID=user:admin
DEFAULT_SYNC_USER_ID=user:admin
NEXT_PUBLIC_DEFAULT_SYNC_USER_ID=user:admin

# ---------------------------------------------------------------------------
# [必填] 数据库配置 - 使用宿主机 PostgreSQL
# ---------------------------------------------------------------------------
# 仅通过 Docker 内网访问宿主机数据库，不得填写服务器公网 IP
PGHOST=172.20.0.1
PGPORT=5432
PGDATABASE=nextchat
PGUSER=dyx
PGPASSWORD=NrCCTyikNREXjiZ6

# SSL 配置（当前远程库未启用 SSL）
PGSSL=false
PGSSLMODE=disable

# 连接池配置
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# 国内加速配置（建议保留）
# ---------------------------------------------------------------------------
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com/

# ---------------------------------------------------------------------------
# 功能配置
# ---------------------------------------------------------------------------
HIDE_USER_API_KEY=false
DISABLE_GPT4=false
ENABLE_BALANCE_QUERY=false
DISABLE_FAST_LINK=false
ENABLE_MCP=false
ENABLE_GOOGLE_FONTS=false

# ---------------------------------------------------------------------------
# GitHub 配置
# ---------------------------------------------------------------------------
GITHUB_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

APP_SECRET=nextchat_password


# 备份数据库（对话备份 / API 配置备份）
BACKUP_DATABASE_URL=
BACKUP_PGHOST=172.20.0.1
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=nextchat_backup
BACKUP_PGUSER=dyx
BACKUP_PGPASSWORD=NrCCTyikNREXjiZ6
BACKUP_PGSSL=false
BACKUP_PGSSLMODE=disable
BACKUP_PGPOOL_MAX=5
BACKUP_PG_CONNECT_TIMEOUT_MS=10000
BACKUP_PG_IDLE_TIMEOUT_MS=30000
BACKUP_PG_RETRY_COUNT=3
