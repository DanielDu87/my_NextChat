# Docker / 国内服务器部署示例
# 使用方式：
# 1. 复制为 .env.docker 或直接写入你的部署环境变量
# 2. 执行：
#    ./scripts/docker-compose-safe.sh --env-file .env.docker --profile no-proxy build
#    ./scripts/docker-compose-safe.sh --env-file .env.docker --profile no-proxy up -d

# Alpine apk 国内镜像
# 示例：
# ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
ALPINE_MIRROR=

# npm / yarn registry 国内镜像
NPM_REGISTRY=https://registry.npmmirror.com/

# 本地 Docker 开发热加载配置
# 大多数 Linux 服务器 / 本地开发环境建议保持 false，使用原生文件事件，热更新更快
# 如果你使用 Docker Desktop 且发现改文件后不能及时热更新，再改为 true
WATCHPACK_POLLING=false
WATCHPACK_POLLING_INTERVAL=1000
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=1000

# 下面这些是 compose 运行时常见变量，可按需填写
# 当前部署约定为全程不使用代理，因此这里不提供 PROXY_URL
OPENAI_API_KEY=
GOOGLE_API_KEY=
CODE=
BASE_URL=
OPENAI_ORG_ID=
HIDE_USER_API_KEY=
DISABLE_GPT4=
ENABLE_BALANCE_QUERY=
DISABLE_FAST_LINK=
ENABLE_MCP=
ENABLE_GOOGLE_FONTS=false
GITHUB_BASE_URL=
GITHUB_API_BASE_URL=
GITHUB_RAW_BASE_URL=
ENABLE_SHAREGPT=false
SHAREGPT_URL=
MCP_MARKET_URL=
ENABLE_EDGE_TTS=false
EDGE_TTS_VOICES_URL=
EDGE_TTS_WSS_URL=
OPENAI_SB=
WHITE_WEBDAV_ENDPOINTS=

# 数据库 / WebDAV
# 服务器部署建议直接填写固定数据库地址，不依赖 SSH 隧道
# 示例：
# PGHOST=10.0.0.12
# PGPORT=5432
# PGDATABASE=nextchat
# PGUSER=nextchat_user
# PGPASSWORD=your-password
# 或者直接填写 DATABASE_URL
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=
PGSSLMODE=
PGPOOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# SSH 隧道仅在需要通过跳板机访问数据库时才启用
# 启用方式：
# ./scripts/docker-compose-safe.sh --env-file .env.docker --profile no-proxy --profile ssh-tunnel up -d
# 启用后请把 PGHOST / DATABASE_URL 指向 compose 服务名 `postgres-ssh-tunnel`
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=222
SSH_TUNNEL_USER=
SSH_TUNNEL_PASSWORD=
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_LOCAL_PORT=5432

# 如需本地临时 PostgreSQL，可额外启用：
# ./scripts/docker-compose-safe.sh --env-file .env.docker --profile dev --profile local-db up -d
